{
  "name": "@dv.net/ui-kit",
  "private": false,
  "version": "7.7.19",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css",
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "style": "dist/style.css",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "build-only": "vite build",
    "build-demo": "vite build --mode demo",
    "lint": "eslint . && npx stylelint \"**/*.{vue,css,scss}\"",
    "lint:fix": "eslint . --fix && npx stylelint \"**/*.{vue,css,scss}\" --fix",
    "generate-svg-list": "node generate-svg-list.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dv-net/ui-kit.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.43",
    "vue-router": ">=5.3.1"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "maska": "^3.2.2",
    "uuidv7": "^1.2.1",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-virtual-scroller": "^3.0.5",
    "vue3-lottie": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.9",
    "sass": "1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
